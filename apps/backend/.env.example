# Supabase Postgres — Session pooler (port 5432). Keep the ?ssl_mode=disable suffix (see medusa-config.ts).
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-<N>-ap-southeast-1.pooler.supabase.com:5432/postgres?ssl_mode=disable
DB_SSL=true

# Supabase Storage (S3)
S3_FILE_URL=https://<PROJECT_REF>.supabase.co/storage/v1/object/public/pawl-media
S3_ENDPOINT=https://<PROJECT_REF>.storage.supabase.co/storage/v1/s3
S3_REGION=ap-southeast-1
S3_BUCKET=pawl-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Medusa
STORE_CORS=http://localhost:5173
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:9000,http://localhost:5173
# Random strings of 32+ characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
COOKIE_SECRET=change-me
STOREFRONT_URL=http://localhost:5173
BACKEND_URL=http://localhost:9000
# REDIS_URL=   (leave empty in Phase 1)

# Performance (see docs/setup.md)
# Caching Module: keeps Store API product/region/price queries in memory. Changes made in this backend's
# Admin clear it at once; changes from other machines on the shared database appear after CACHE_TTL_SECONDS.
MEDUSA_FF_CACHING=true
CACHE_TTL_SECONDS=300
# Connections to the Supabase Session pooler (Free plan: 15 for the whole project, shared by the team)
DB_POOL_MIN=2
DB_POOL_MAX=5


# Chat assistant (Gemini). Create a key at https://aistudio.google.com/apikey — backend only, never in VITE_*.
# Without GEMINI_API_KEY the assistant answers 503 and the rest of the shop works normally.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# minimal | low | medium | high (gemini-3.5-flash-lite supports all; gemini-3.8-flash has no minimal)
GEMINI_THINKING_LEVEL=low
# Messages allowed per visitor (IP) or signed-in customer per window
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_MINUTES=10
# Behind the Vercel proxy (production): read the visitor IP for the chat rate limit from this header
# CHAT_CLIENT_IP_HEADER=x-forwarded-for
